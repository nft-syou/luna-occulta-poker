{
  "name": "luna-occulta-poker",
  "version": "0.1.0",
  "private": true,
  "description": "宵闇の賭場 — an unofficial 月蝕綺譚 fan poker where the spirits think with TypeSafe Jev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nft-syou/luna-occulta-poker.git"
  },
  "homepage": "https://github.com/nft-syou/luna-occulta-poker#readme",
  "bugs": {
    "url": "https://github.com/nft-syou/luna-occulta-poker/issues"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "typesafe",
    "jev",
    "luna-occulta",
    "cloudflare-workers",
    "react",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "assets:kitan": "node scripts/fetch-kitan-assets.mjs",
    "voice:lines": "tsx scripts/voice/export-lines.ts",
    "assets:sound": "node scripts/fetch-sound.mjs",
    "prose:allowlist": "tsx scripts/prose-allowlist.ts"
  },
  "dependencies": {
    "@jev-poker/agent": "^0.2.1",
    "@jev-poker/engine": "^0.2.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
